# Backend Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/game_mkt
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=your-secret-key-change-in-production-use-strong-random-string-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# NATS
NATS_URL=nats://localhost:4222
NATS_RUNTIME_STREAM=gamemkt.runtime

# OpenTelemetry
OTEL_ENABLED=true
OTEL_JAEGER_AGENT_HOST=localhost
OTEL_JAEGER_AGENT_PORT=6831

# External Integrations
JOHN_BASE_URL=http://john-brasileiro:8000
CEFEIDA_BASE_URL=http://cefeida:8000
ARCHIMEDES_BASE_URL=http://archimedes:8000
JOHN_RUNTIME_URL=http://john:8080
ARCHIMEDES_URL=http://archimedes:8000
CEA_URL=http://cea:8001
ACADEMIA_URL=http://academia:8110

# Interplanetary Runtime Flags
INTERPLANETARY_RUNTIME=true
FEDERATION_AUTHORITY=true
KNOWLEDGE_GRAPH=true
ECOSYSTEM_MEMORY=true
UNIFIED_OBSERVABILITY=true
CAUSAL_RUNTIME=true
HOLOGRAPHIC_COMMERCE=true
PLANETARY_MARKETING=true
INTERPLANETARY_SALES=true

# App Settings
APP_NAME=GAME MKT
APP_VERSION=2.0.0
DEBUG=false
