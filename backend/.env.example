# Environment Variables - GAME MKT Backend

# Servidor
PORT=3001
NODE_ENV=development

# Logging
LOG_LEVEL=debug

# Database (Futuro)
# DATABASE_URL=postgresql://user:password@localhost:5432/game_mkt
# REDIS_URL=redis://localhost:6379

# Autenticação (Futuro)
# JWT_SECRET=sua_secret_key_muito_segura_aqui
# JWT_EXPIRE=7d

# Integrações Externas (Futuro)
# HUBSPOT_API_KEY=sua_chave_api
# FACEBOOK_ACCESS_TOKEN=seu_token
# GOOGLE_ANALYTICS_KEY=sua_chave

# Rate Limiting
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# CORS
# ALLOWED_ORIGINS=http://localhost:5173,https://game-mkt.app

# Notificações (Futuro)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu_email@gmail.com
# SMTP_PASS=sua_senha_app

# Runtime Federativo LICEU 6.0
MONOLITH_ID=game-mkt
NATS_SERVERS=nats://localhost:4222
FEDERATION_ENABLED=true
GRAPH_URI=bolt://localhost:7687
GRAPH_USER=neo4j
GRAPH_PASSWORD=liceugraph
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_ENABLED=true
JOHN_RUNTIME_URL=http://localhost:8010
WARROOM_ENABLED=true
HOLOGRAPHIC_RUNTIME=true
INTERPLANETARY_MARKET_ENABLED=true
